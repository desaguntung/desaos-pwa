  id            BigInt        @id @default(autoincrement())
  dusun_id      BigInt
  nomor_rw      Int           @db.SmallInt
  kepala_nik    String?
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @db.Timestamptz(6)
  wilayah_rt    wilayah_rt[]
  wilayah_dusun wilayah_dusun @relation(fields: [dusun_id], references: [id], onDelete: Cascade)
  penduduk      penduduk?     @relation(fields: [kepala_nik], references: [nik])

  @@unique([dusun_id, nomor_rw], map: "wilayah_rw_unique_per_dusun")
  @@index([dusun_id], map: "idx_wilayah_rw_dusun_id")
  @@schema("public")
}

